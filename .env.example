# Variables d'environnement du site — AUCUNE VALEUR SECRÈTE ICI.
#
# Ce fichier est versionné : il documente les variables, il n'en porte pas les
# valeurs. Le site est entièrement statique et ne s'authentifie nulle part, donc
# il n'a besoin d'aucun secret — et ne doit jamais en recevoir.

# L'origine publique du site. Sert aux URLs canoniques, aux hreflang et à Open
# Graph. Sans elle, le site se construit quand même : la valeur par défaut est
# le domaine du projet.
NEXT_PUBLIC_SITE_URL=https://amissan.dev

# L'origine de portfolio-api, d'où vient le CV en PDF (ADR 0004).
# Le chemin est fixé par le contrat de l'API : GET /v1/cv/{fr|en}.pdf
NEXT_PUBLIC_API_BASE_URL=https://api.amissan.dev
