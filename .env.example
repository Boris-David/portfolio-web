# The site's environment variables — NO SECRET VALUE HERE.
#
# This file is tracked: it documents the variables, it does not carry their
# values. The site is entirely static and authenticates nowhere, so it needs no
# secret — and must never be given one.

# The site's public origin. Used for the canonical URLs, the hreflang tags and
# Open Graph. Without it the site still builds: the default value is the
# project's domain.
NEXT_PUBLIC_SITE_URL=https://amissan.dev

# The origin of portfolio-api, where the PDF résumé comes from (ADR 0004).
# The path is fixed by the API contract: GET /v1/cv/{fr|en}.pdf
NEXT_PUBLIC_API_BASE_URL=https://api.amissan.dev
