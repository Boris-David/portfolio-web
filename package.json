{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run tokens:check && npm run lint && npm run typecheck && npm run test && npm run check:secrets",
    "lighthouse": "npx --yes @lhci/cli@0.15.x autorun --config=lighthouserc.json",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:contract": "vitest run --config vitest.contract.config.mts"
  },
  "dependencies": {
    "motion": "^13.4.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  }
}
