# Headers served by Cloudflare Workers Static Assets.
#
# This file replaces the `headers` from `vercel.json`, removed along with
# Vercel. It is copied into `out/` by the export, and Cloudflare reads it as
# configuration instead of serving it as a file.
#
# It is tracked and reviewed in code review, which configuration set in a
# dashboard never would be.

/*
  # The site loads no third-party script, displays no user input and makes no
  # outbound request — except the link to the API's résumé.
  #
  # `'unsafe-inline'` on scripts is a documented choice, not an oversight: Next
  # inlines its own scripts for the RSC payload, and forbidding them would
  # require a nonce, therefore per-request rendering, therefore a Worker on the
  # hot path. We would pay with static generation to close an empty surface.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Next's assets carry a fingerprint in their name: their content cannot change
# without the URL changing. They are therefore immutable for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The images are tracked with the repository and change with a deployment.
# One day of browser cache, then revalidation.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/shots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# ── Universal links ─────────────────────────────────────────────────────────
#
# The association file iOS reads. Three platform requirements, and each one is
# paid for with a link that opens in Safari instead of the app — without a
# single error message:
#
#   1. served as `application/json`, even though it has **no** `.json` extension;
#   2. served over HTTPS, with no redirect at all;
#   3. unsigned — which was required before iOS 9 and no longer is.
#
# It is not cached for long: iOS rereads it as installs happen, and a corrected
# association has to be able to propagate without waiting a year.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
