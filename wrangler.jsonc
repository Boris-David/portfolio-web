{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-web",

  // The platform APIs are pinned to this date: a workerd update cannot change
  // behaviour without us having decided it by moving this line forward. Same
  // date as `portfolio-api`, deliberately.
  "compatibility_date": "2026-09-17",

  // NO `main`. There is no Worker script at all, and that is the heart of the
  // choice: the site is entirely prerendered, so every request is served by the
  // static asset store — free, unlimited, and **outside the quota of 100,000
  // requests a day**. Adding a Worker on the hot path would turn every page
  // view into a billable invocation, to deliver exactly nothing more.

  "assets": {
    // Produced by `next build` with `output: "export"`.
    "directory": "./out",

    // `/en` serves `en.html`, `/` serves `index.html`. That is exactly the
    // shape Next's export produces — no rewriting to plan for.
    "html_handling": "auto-trailing-slash",

    // Next's 404 page, with its layout and its two languages.
    "not_found_handling": "404-page",
  },

  // `amissan.dev` is registered with Cloudflare Registrar, so the zone is
  // already on the account: `wrangler deploy` creates the DNS record and the
  // custom domain itself. Nothing to click.
  //
  // `www.amissan.dev` is NOT here, and that is deliberate — see the header of
  // `.github/workflows/deploy.yml`: a host redirect cannot be done from this
  // file without putting a Worker back on the hot path.
  "routes": [{ "pattern": "amissan.dev", "custom_domain": true }],

  "observability": { "enabled": true },
}
